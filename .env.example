# Laikinas pavadinimas – galutinį pasirinksi pats (naudojamas per config('app.name'))
APP_NAME="Paslaugų platforma"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=lt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=lt_LT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Testiniai duomenys (docs/SEEDING.md): 0.05 – greitas dev seed'as, 1 – pilnas (≈1,8 mln. eilučių)
SEED_SCALE=0.05
# true – demo paveikslėliai (abstraktūs logotipai, viršeliai, portfolio); lėčiau, todėl pagal nutylėjimą išjungta
SEED_MEDIA=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Dev'e – SQLite (failas database/database.sqlite). Produkcijoje / pilnam seed'ui – MySQL 8.4:
# DB_CONNECTION=mysql, atkomentuok žemiau esančias eilutes ir įrašyk savo duomenis.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=paslaugos
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Etapas 7: mokėjimai (config/payments.php). Dev'e – netikras tiekėjas „fake" (be tikrų pinigų),
# produkcijoje – „paysera". Paysera duomenys – savitarnoje: Projektai → projektas → Bendri nustatymai.
PAYMENT_GATEWAY=fake
PAYSERA_PROJECT_ID=
PAYSERA_SIGN_PASSWORD=
PAYSERA_TEST=true
# Lokaliai per tunelį (pvz. ngrok), nes Paysera serveris localhost'o nepasiekia
PAYSERA_CALLBACK_URL=
LOW_CREDITS_THRESHOLD=3

# Etapas 9c: kiek kategorijų teikėjas gali pasirinkti be prenumeratos (config/marketplace.php)
FREE_MAX_CATEGORIES=5

# Sąskaitos faktūros (config/invoices.php). Pavadinimas, jei tuščias, – APP_NAME
INVOICE_SELLER_NAME=
INVOICE_SELLER_CODE=
INVOICE_SELLER_VAT_CODE=
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_IBAN=
INVOICE_VAT_PAYER=false
INVOICE_VAT_RATE=21

# --- Etapas 8: saugumas ir produkcija (pilnas sąrašas – docs/DEPLOYMENT.md → „.env produkcijai") ---
# APP_ENV=production
# APP_DEBUG=false                  # niekada true produkcijoje: klaidos puslapis parodytų kodą ir .env reikšmes
# APP_URL=https://www.example.lt   # su https – pagal jį generuojamos nuorodos, sitemap.xml, canonical
#
# Sesija ir slapukai:
# SESSION_DRIVER=redis             # arba database; failai netinka, kai serverių daugiau nei vienas
# SESSION_SECURE_COOKIE=true       # slapukas siunčiamas tik per HTTPS
# SESSION_HTTP_ONLY=true           # JavaScript negali perskaityti sesijos slapuko (numatytoji reikšmė)
# SESSION_SAME_SITE=lax            # apsauga nuo CSRF iš kitų svetainių; strict sulaužytų atėjimą iš el. laiško nuorodų
# SESSION_ENCRYPT=true             # sesijos turinys šifruojamas saugykloje (Redis/DB)
# SESSION_LIFETIME=120             # minutės be veiksmų iki atjungimo
# SESSION_DOMAIN=                  # tuščia – tik šis domenas (be subdomenų)
#
# Saugos antraštės (config/security.php):
# SECURITY_HEADERS_ENABLED=true
# CSP_ENABLED=true
# CSP_REPORT_ONLY=false            # true – pirmą savaitę tik stebėti pažeidimus, neblokuojant
# CSP_REPORT_URI=                  # pvz. Sentry CSP endpoint'as
# CSP_EXTRA_IMG_SRC=               # kableliais: papildomi paveikslėlių domenai (CDN)
# CSP_EXTRA_CONNECT_SRC=
# CSP_EXTRA_FRAME_SRC=
# CSP_EXTRA_FORM_ACTION=           # papildomi mokėjimų tiekėjai (Paysera jau leidžiama)
# HSTS_MAX_AGE=31536000
#
# Logai produkcijoje (config/logging.php):
# LOG_CHANNEL=stack
# LOG_STACK=daily,slack            # failas kasdien + kritinės klaidos į Slack
# LOG_LEVEL=info                   # debug – tik dev'e (per daug įrašų ir gal asmens duomenų)
# LOG_DAILY_DAYS=14                # kiek dienų laikyti logų failus
# LOG_SLACK_WEBHOOK_URL=           # Slack „Incoming Webhook" adresas
# LOG_SLACK_LEVEL=critical         # į Slack – tik critical ir aukščiau
