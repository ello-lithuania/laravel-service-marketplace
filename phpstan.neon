includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    # Larastan skaito modelių casts() metodo turinį (enum'ai, datos), o ne tik grąžinamą tipą „array".
    # Be to $serviceRequest->status būtų „string", nors Eloquent grąžina ServiceRequestStatus enum'ą.
    parseModelCastsMethod: true
